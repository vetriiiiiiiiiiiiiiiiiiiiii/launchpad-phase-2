# Copy to .env for local use. Never commit .env or paste secrets into chat.
# Production requires a strong ADMIN_PASSWORD with at least 16 characters.
# ADMIN_PASSWORD=replace-with-a-long-random-secret
# PostgreSQL app connection string. Create the database before starting the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad?schema=public
# Direct PostgreSQL connection used by Prisma migrations. Can match DATABASE_URL
# when your provider does not require a separate direct connection.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/launchpad?schema=public
# Your production public origin, used for canonical URLs and the sitemap.
# SITE_URL=https://your-domain.example
# Set to the number of trusted reverse proxies in front of the app, often 1.
# Leave unset when connecting directly.
# TRUST_PROXY_HOPS=1
# PORT=8787 (production port; dev uses 8787 for the API and 5173 for the site)
