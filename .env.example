# Copy to .env. Leave ADMIN_PASSWORD unset for an open admin panel (local use only);
# set a strong password before the site goes live.
# ADMIN_PASSWORD=change-me
# PostgreSQL connection string. Create the database before starting the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/launchpad?schema=public
# PORT=8787 (production port; dev uses 8787 for the API and 5173 for the site)
