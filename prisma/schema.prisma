generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model EventSettings {
  id            String   @id
  values        Json     @default("{}") @db.JsonB
  faqConfigured Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model ImageSlot {
  key       String   @id @db.VarChar(40)
  source    String   @db.VarChar(2000)
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(200)
  answer    String   @db.VarChar(1200)
  sortOrder Int      @unique
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  sha256      String   @unique @db.VarChar(64)
  contentType String   @db.VarChar(32)
  data        Bytes
  createdAt   DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Speaker {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(120)
  role         String   @default("") @db.VarChar(160)
  organisation String   @default("") @db.VarChar(160)
  topic        String   @default("") @db.VarChar(240)
  photo        String   @default("") @db.VarChar(2000)
  sortOrder    Int      @unique
  updatedAt    DateTime @updatedAt
}

model Ticket {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  seat      String   @unique @db.VarChar(4)
  name      String   @db.VarChar(80)
  year      String   @db.VarChar(20)
  dept      String   @db.VarChar(60)
  section   String   @db.VarChar(20)
  createdAt DateTime @default(now())
}
